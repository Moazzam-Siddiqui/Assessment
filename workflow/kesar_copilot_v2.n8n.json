{
  "name": "Kesar Support Copilot v2 (UNTESTED BLUEPRINT)",
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "kesar-support",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "n2",
      "name": "Sanitize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Untrusted input: strip paragraphs that try to instruct the system\nconst e = $input.first().json.body;\nconst re = /(system note|ignore (all )?(previous|prior) (instructions|policies)|note to (the )?ai|as an ai assistant|you are now)/i;\nconst parts = e.body.split(/\\n\\s*-{3,}\\s*\\n|\\n\\s*\\n/);\nconst kept = parts.filter(p => !re.test(p));\nreturn [{ json: { ...e, clean_body: kept.join('\\n\\n'), injection_suspected: kept.length !== parts.length } }];"
      }
    },
    {
      "id": "n3",
      "name": "Classify (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'claude-haiku-5-5',max_tokens:400,temperature:0,system:$('Classify prompt').first().json.prompt,messages:[{role:'user',content:'<email>\\nFrom: '+$json.from.email+'\\nSubject: '+$json.subject+'\\n\\n'+$json.clean_body+'\\n</email>'}]}) }}",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Anthropic API (set in n8n, header x-api-key)"
        }
      }
    },
    {
      "id": "n4",
      "name": "Validate / repair JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Parse + validate LLM JSON against schemas/llm_output.schema.json; fall back safely (never drop the email)\nconst intents=['order_status','product_query','return_refund','complaint','other'];\nconst sent=['positive','neutral','negative','angry']; const langs=['en','hi','hinglish'];\nlet o, err='';\ntry { o = JSON.parse(($json.content[0].text.match(/\\{[\\s\\S]*\\}/)||[''])[0]); } catch(e){ err='unparseable'; }\nconst ok = o && intents.includes(o.intent) && (o.secondary_intent===null||intents.includes(o.secondary_intent))\n  && (o.order_id===null||/^KC-[0-9]{4}$/.test(o.order_id)) && sent.includes(o.sentiment) && langs.includes(o.language)\n  && typeof o.confidence==='number' && o.confidence>=0 && o.confidence<=1 && typeof o.summary==='string' && o.summary.length<=200;\nconst src = $('Sanitize email').first().json;\nif (!ok) o = {intent:'other',secondary_intent:null,order_id:null,sentiment:'neutral',language:'en',confidence:0,summary:'Classification failed',injection_suspected:false};\nreturn [{ json: { ...src, cls:o, error: ok?'':(err||'schema_invalid'),\n  needs_human: !ok || o.confidence < 0.70 || o.sentiment==='angry' || src.injection_suspected || o.injection_suspected===true } }];"
      }
    },
    {
      "id": "n5",
      "name": "Load orders.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        160
      ],
      "parameters": {
        "method": "GET",
        "url": "https://raw.githubusercontent.com/<your-user>/<your-repo>/main/data/orders.json"
      }
    },
    {
      "id": "n6",
      "name": "Order lookup + sender check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "// Order lookup: by order_id, else by sender email. Sender must equal customer_email to share details.\nconst orders = $('Load orders.json').first().json.orders;\nconst j = $input.first().json; const sender = j.from.email.toLowerCase();\nlet order = j.cls.order_id ? orders.find(o=>o.order_id===j.cls.order_id) : orders.find(o=>o.customer_email.toLowerCase()===sender);\nconst found = !!order; const mismatch = found && order.customer_email.toLowerCase()!==sender;\nreturn [{ json: { ...j, order_found: found, privacy_mismatch: mismatch, order: mismatch?null:order } }];"
      }
    },
    {
      "id": "n7",
      "name": "Policy checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// Deterministic policy checks (not left to the LLM). 'today' = received_at date, never the system clock.\nconst j=$input.first().json; if(!j.order) return [{json:{...j, eligibility:null}}];\nconst days=(a,b)=>Math.round((new Date(b)-new Date(a))/86400000);\nconst rd=j.received_at.slice(0,10); const t=(j.clean_body||'').toLowerCase();\nconst delivered=j.order.status==='delivered';\nconst d=delivered?days(j.order.delivered_date,rd):null;\nconst used=/used (them|it)|have been using|didn't suit|no difference/.test(t)&&!/unopened|never opened|seal/.test(t);\nconst unopened=/unopened|never opened|sealed|seals? intact/.test(t);\nreturn [{json:{...j, eligibility:{delivered, days_since_delivery:d, within_7_days:delivered&&d<=7,\n  within_48h:delivered&&d<=2, used, unopened, eligible:delivered&&d<=7&&!used&&unopened}}}];"
      }
    },
    {
      "id": "n8",
      "name": "Route by intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1320,
