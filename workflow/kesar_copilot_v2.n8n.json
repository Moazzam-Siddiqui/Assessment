      "name": "Tool: search_faq",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [
        1700,
        60
      ],
      "parameters": {
        "name": "search_faq",
        "description": "Search the company FAQ (only source of truth for policy and product answers).",
        "jsCode": "const faq = $('Load faq.md').first().json.data;\nconst words=(query||'').toLowerCase().split(/\\W+/).filter(w=>w.length>3);\nconst secs=faq.split(/\\n(?=## )/);\nconst hits=secs.filter(s=>words.some(w=>s.toLowerCase().includes(w)));\nreturn hits.length?hits.join('\\n\\n'):'no matching FAQ passage';"
      }
    },
