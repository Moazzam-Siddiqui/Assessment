      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "order_status",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.cls.intent}}",
                    "rightValue": "order_status",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "product_query",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.cls.intent}}",
