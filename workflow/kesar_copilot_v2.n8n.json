        "name": "get_order",
        "description": "Look up an order by order_id or customer email. Returns the order or 'not found'.",
        "jsCode": "const orders = $('Load orders.json').first().json.orders;\nconst q=(query||'').trim();\nconst o=orders.find(x=>x.order_id===q||x.customer_email.toLowerCase()===q.toLowerCase());\nreturn o?JSON.stringify(o):'not found';"
      }
    },
    {
